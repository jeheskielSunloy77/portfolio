# Base URL for the application
PORT=4321
APP_URL=http://localhost:4321

# [Optional] AI Chatbot
# Providers supported: google (default) | openai | anthropic
# - Google (default): set AI_API_KEY with your Google AI Studio key
# - OpenAI / compatible (Groq, Ollama, DeepSeek, OpenRouter): set AI_PROVIDER=openai, AI_API_KEY, and optional AI_BASE_URL (e.g. http://localhost:11434/v1 for Ollama)
# - Anthropic: set AI_PROVIDER=anthropic and AI_API_KEY
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# [Optional] Database - Powers the Visitor Doodle / Sketch Wall
# Providers supported: postgres (default) | sqlite | mysql | mongodb
# (Auto-detected from DATABASE_URL if DB_PROVIDER is omitted)
# Examples:
# - PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/portfolio
# - SQLite:     DATABASE_URL=file:./local.db  (or libsql://... for Turso cloud)
# - MySQL:      DATABASE_URL=mysql://user:password@localhost:3306/portfolio
# - MongoDB:    DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/portfolio
DB_PROVIDER=
DATABASE_URL=

# [Optional] SMTP - Powers the Contact Me form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or optional single connection string:
# SMTP_URL=smtp://user:pass@smtp.example.com:587

