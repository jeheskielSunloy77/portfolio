# Base URL for the application
PORT=4321
APP_URL=http://localhost:4321

# [Optional] Google Gemini AI - Powers the interactive AI chatbot
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# [Optional] MongoDB - Powers the Visitor Doodle / Sketch Wall
# Can be local (mongodb://localhost:27017/portfolio) or MongoDB Atlas URI
MONGODB_URI=
MONGODB_DB=portfolio

# [Optional] SMTP - Powers the Contact Me form
# Example using Gmail: host=smtp.gmail.com, port=587, user=your@email.com, pass=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
