---
import VisitorsPage from '@/views/visitors.astro'
import { NON_DEFAULT_LANGUAGES, type Language } from '@/i18n/i18n'

export const prerender = false

const langParam = Astro.params.lang
if (langParam === 'en') {
	return Astro.redirect('/visitors', 308)
}
if (!langParam || !NON_DEFAULT_LANGUAGES.includes(langParam as Language)) {
	return Astro.rewrite('/404')
}

const lang = langParam as Language
---

<VisitorsPage lang={lang} />
