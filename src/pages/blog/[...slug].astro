---
import BlogPostView from '@/views/blog-post.astro'
import { getCollection, type CollectionEntry } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
	const posts = await getCollection('post', (post) => post.data.lang === 'en')

	return posts.map((post) => {
		const [, slug] = post.id.split('/')

		return {
			params: { slug },
			props: post,
		}
	})
}

export type Props = CollectionEntry<'post'>

const post = Astro.props
const { slug } = Astro.params
---

<BlogPostView lang='en' post={post} slug={slug!} />
